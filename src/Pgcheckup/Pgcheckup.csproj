<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pgcheckup</AssemblyName>
    <RootNamespace>Pgcheckup</RootNamespace>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <PgcheckupChecksDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../checks/'))</PgcheckupChecksDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pgcheckup.Checks.Generator\Pgcheckup.Checks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="PgcheckupChecksDir" />
    <AdditionalFiles Include="$(PgcheckupChecksDir)**/*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pgcheckup.Tests" />
  </ItemGroup>
</Project>
